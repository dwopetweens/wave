# /etc/systemd/system/freelancer-mcp.service
#
# Runs next to the bidding agent, as the same user and from the same directory, so
# it reads the same .env and config.yaml and shares projects.db with the poller,
# portal and Telegram bot. Uses its own Python 3.11 venv (.venv-mcp): the MCP SDK
# needs Python 3.10+, and the agent's .venv stays on 3.9 untouched.

[Unit]
Description=Freelancer.com MCP server (remote connector for Claude)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=denniskiama-portal
Group=denniskiama-portal
WorkingDirectory=/home/denniskiama-portal/freelancer-bidder
ExecStart=/home/denniskiama-portal/freelancer-bidder/.venv-mcp/bin/python mcp_server.py serve
Restart=on-failure
RestartSec=5

# Hardening. Writes are limited to the agent directory (projects.db and the
# server's mcp_auth.db live there); the rest of the system is read-only.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/denniskiama-portal/freelancer-bidder
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
