# MCP server settings. Copy the lines you need into the agent's .env (never commit .env).
# The agent's own variables (Freelancer token, Claude API key, Telegram) stay as they are.

# Public origin Claude connects to (no path, no trailing slash). The MCP endpoint is $MCP_PUBLIC_URL/mcp.
MCP_PUBLIC_URL=https://mcp.example.com
# Where the server listens. Keep 127.0.0.1: only Nginx should reach it.
MCP_HOST=127.0.0.1
MCP_PORT=8765

# agent = real Freelancer.com account via the agent's modules; fake = sample data for testing.
MCP_BACKEND=fake
# true: place_bid and send_message run all checks but submit nothing. Set false only to go live.
MCP_DRY_RUN=true
# Optional ceiling on any single bid, in the project's currency.
MCP_MAX_BID_AMOUNT=

# Throttle for this server's Freelancer API calls (the agent shares the same token).
MCP_API_MAX_CALLS=30
MCP_API_PERIOD_SECONDS=60

# Owner login for the OAuth sign-in page. Generate both with: python mcp_server.py init-auth
MCP_OWNER_PASSWORD_HASH=
MCP_OWNER_TOTP_SECRET=
# OAuth state (clients and hashed tokens). Separate from the agent's database.
MCP_AUTH_DB=mcp_auth.db
# Allow http://localhost redirects, needed only to sign in from the MCP Inspector. Leave false otherwise.
MCP_ALLOW_LOOPBACK_REDIRECTS=false
MCP_ACCESS_TOKEN_TTL=3600
MCP_REFRESH_TOKEN_TTL=2592000

# Local testing only: skip OAuth. Refused unless MCP_HOST and MCP_PUBLIC_URL are both localhost.
MCP_AUTH_DISABLED=false
